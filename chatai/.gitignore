# Runtime data — chats, personas, characters, settings, avatars.
# This is local, personal chat data and should never be committed.
data/*
!data/.gitkeep
!data/README.md

.venv/
__pycache__/
*.pyc
.pytest_cache/

# Self-signed TLS certificate/key for LAN HTTPS (generated locally).
certs/

# The repository root .gitignore ignores *.json globally (game save files);
# the bundled example character card is source, not runtime data.
!characters/*.json
